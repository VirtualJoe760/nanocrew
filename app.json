{
  "expo": {
    "name": "Nano Crew",
    "slug": "nanocrew",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nanocrew",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.nanocrew.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Nano Crew uses the microphone so you can talk to Eve, your AI brand consultant.",
        "NSPhotoLibraryUsageDescription": "Nano Crew uses your photos for virtual try-on and to set your brand's post and product images.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "53"
    },
    "android": {
      "package": "com.nanocrew.app",
      "adaptiveIcon": {
        "backgroundColor": "#16161a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "versionCode": 6
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "react-native-audio-api",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/brand/eve-boot.png",
          "resizeMode": "cover",
          "android": {
            "image": "./assets/brand/eve-boot.png",
            "resizeMode": "cover",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-asset",
      "expo-notifications",
      "expo-apple-authentication",
      "react-native-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2bf027c9-53e8-4125-8fc8-7679b44942bc"
      }
    },
    "owner": "averagexjoe",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2bf027c9-53e8-4125-8fc8-7679b44942bc"
    }
  }
}
