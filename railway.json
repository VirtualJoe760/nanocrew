{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx expo export -p web"
  },
  "deploy": {
    "startCommand": "npx expo serve --port $PORT",
    "healthcheckPath": "/",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
