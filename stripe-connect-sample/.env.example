# Copy to .env and fill in. Test mode keys: https://dashboard.stripe.com/test/apikeys

# REQUIRED — your platform's secret key (test mode: sk_test_…)
STRIPE_SECRET_KEY=

# Where this sample runs (used for return/refresh/success URLs)
BASE_URL=http://localhost:4242
PORT=4242

# Marketplace commission taken on each storefront sale (percent)
PLATFORM_FEE_PERCENT=10

# A recurring Price id for the SaaS plan the BRAND subscribes to (price_…).
# Create it in the Dashboard → Products. Leave blank to skip the subscription demo.
SAAS_PRICE_ID=

# Webhook signing secrets (from `stripe listen`). Optional for the happy path.
#   Account (THIN/v2):  stripe listen --thin-events 'v2.core.account[requirements].updated,v2.core.account[configuration.merchant].capability_status_updated,v2.core.account[configuration.customer].capability_status_updated' --forward-thin-to localhost:4242/webhooks/account
#   Subscriptions:      stripe listen --forward-to localhost:4242/webhooks/subscriptions
ACCOUNT_WEBHOOK_SECRET=
SUB_WEBHOOK_SECRET=
